<div class="pt-24 pb-20 bg-night min-h-screen">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <%= link_to products_path, class: "inline-flex items-center gap-1.5 text-sm text-parchment-dim hover:text-flame transition-colors mb-10" do %>
      <%= icon("arrow-left", css_class: "w-4 h-4") %> Back
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
      <div class="aspect-square bg-gradient-to-br from-ember to-ember-light rounded-xl overflow-hidden warm-shadow-lg">
        <img src="<%= @product.primary_image %>" alt="<%= @product.name %>" class="w-full h-full object-cover">
      </div>

      <div class="pt-4">
        <span class="inline-block text-[10px] font-semibold px-2.5 py-1 rounded-full border mb-3 <%= category_badge_class(@product.category) %>">
          <%= @product.category %>
        </span>
        <h1 class="font-display text-3xl md:text-4xl tracking-tight text-parchment mb-4"><%= @product.name %></h1>

        <div class="flex items-center gap-3 mb-6">
          <div class="text-2xl font-bold text-flame"><%= format_price(@product.price) %></div>
          <div class="flex items-center gap-1 text-xs text-parchment-dim">
            <%= render "shared/animated_diya", size: 20 %> <span>Inclusive of all taxes</span>
          </div>
        </div>

        <p class="text-parchment-dim leading-relaxed mb-8"><%= @product.description %></p>

        <% if @product.ritual_contents.present? %>
          <div class="mb-8 border border-line bg-ember/60 rounded-lg p-5">
            <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-flame mb-3">What&rsquo;s inside</p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-parchment-dim">
              <% @product.ritual_contents.each do |item| %>
                <li class="flex items-center gap-2"><%= icon("check", css_class: "w-3.5 h-3.5 text-leaf shrink-0") %> <%= item %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="flex flex-wrap gap-2 mb-8">
          <% @product.tags.each do |tag| %>
            <span class="px-3 py-1.5 bg-ember-light text-parchment-dim text-xs font-medium rounded-full border border-line"><%= tag %></span>
          <% end %>
        </div>

        <% if @product.in_stock? %>
          <%= button_to cart_items_path(product_id: @product.id), method: :post,
                data: { turbo_submits_with: "Adding..." },
                class: "w-full flex items-center justify-center gap-2.5 py-4 font-semibold text-sm transition-all duration-300 rounded-md bg-flame text-night hover:bg-marigold warm-shadow hover:warm-shadow-lg" do %>
            <%= icon("shopping-bag", css_class: "w-4 h-4") %> Add to Cart &mdash; <%= format_price(@product.price) %>
          <% end %>
        <% else %>
          <div class="w-full flex items-center justify-center gap-2.5 py-4 font-semibold text-sm rounded-md bg-kumkum/30 text-kumkum border border-kumkum/50">Out of Stock</div>
        <% end %>

        <div class="flex items-center justify-center gap-2 text-xs text-parchment-dim mt-4">
          <svg viewBox="0 0 24 24" fill="none" class="w-3 h-3 text-flame"><path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z" fill="currentColor"/></svg>
          <span>Free shipping on orders above &#8377;999</span>
          <svg viewBox="0 0 24 24" fill="none" class="w-3 h-3 text-flame"><path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z" fill="currentColor"/></svg>
        </div>
      </div>
    </div>
  </div>
</div>
