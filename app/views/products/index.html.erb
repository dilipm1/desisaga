<div class="pt-24 pb-20 bg-night min-h-screen rangoli-pattern">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="mb-10">
      <h1 class="font-display text-4xl md:text-5xl tracking-tight text-parchment mb-2">
        <%= @selected_category || "All Hampers" %>
      </h1>
      <p class="text-parchment-dim text-sm">
        <%= pluralize(@pagy.count, "product") %> found<% if @pagy.pages > 1 %> · page <%= @pagy.page %> of <%= @pagy.pages %><% end %>
      </p>
      <div class="festive-divider mt-4 w-24"></div>
    </div>

    <%= form_with url: products_path, method: :get, local: true, class: "mb-6 flex flex-col sm:flex-row gap-4 items-start sm:items-end" do |form| %>
      <% if @selected_category %><%= form.hidden_field :category, value: @selected_category %><% end %>
      <% if @selected_region.present? %><%= form.hidden_field :region, value: @selected_region %><% end %>
      <div class="flex-1 max-w-sm w-full">
        <%= form.text_field :q, value: params[:q], placeholder: "Search hampers...",
              class: "w-full border-b-2 border-line pb-2 text-sm focus:outline-none focus:border-flame transition-colors bg-transparent text-parchment placeholder:text-parchment-dim/50" %>
      </div>
      <%= form.select :sort,
            [["Name (A-Z)", "name"], ["Price (Low-High)", "price"], ["Price (High-Low)", "price.desc"]],
            { selected: @selected_sort }, { onchange: "this.form.submit()", class: "text-sm font-medium transition-all px-4 py-2 rounded-full border bg-transparent text-parchment-dim hover:text-flame border-line hover:border-flame/50 w-48" } %>
    <% end %>

    <div class="flex gap-2 flex-wrap mb-3">
      <% base_params = {}.tap { |h| h[:q] = params[:q] if params[:q].present?; h[:region] = params[:region] if params[:region].present?; h[:sort] = params[:sort] if params[:sort].present? } %>
      <%= link_to "All", products_path(base_params),
            class: "text-sm font-medium transition-all px-4 py-2 rounded-full border #{!@selected_category ? 'bg-flame text-night border-transparent' : 'text-parchment-dim hover:text-parchment border-line hover:border-flame/50 bg-ember'}" %>
      <% Product::CATEGORIES.each do |cat| %>
        <%= link_to cat, products_path(base_params.merge(category: cat)),
              class: "text-sm font-medium transition-all px-4 py-2 rounded-full border #{@selected_category == cat ? 'bg-flame text-night border-transparent' : "#{category_badge_class(cat)} hover:opacity-80"}" %>
      <% end %>
    </div>

    <% if Product::REGIONS.reject { |r| r == "default" }.any? %>
      <div class="flex gap-2 flex-wrap mb-10 items-center">
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-parchment-dim mr-1">Region:</span>
        <% region_base = {}.tap { |h| h[:q] = params[:q] if params[:q].present?; h[:category] = params[:category] if params[:category].present?; h[:sort] = params[:sort] if params[:sort].present? } %>
        <%= link_to "All regions", products_path(region_base),
              class: "text-xs font-medium transition-all px-3 py-1.5 rounded-full border #{!@selected_region ? 'bg-ember-light text-parchment border-flame/40' : 'text-parchment-dim border-line hover:border-flame/30'}" %>
        <% Product::REGIONS.reject { |r| r == "default" }.each do |reg| %>
          <%= link_to reg.humanize, products_path(region_base.merge(region: reg)),
                class: "text-xs font-medium transition-all px-3 py-1.5 rounded-full border #{@selected_region == reg ? 'bg-flame text-night border-transparent' : 'text-parchment-dim border-line hover:border-flame/30 hover:text-parchment'}" %>
        <% end %>
      </div>
    <% end %>

    <% if @products.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        <%= render partial: "shared/product_card", collection: @products, as: :product %>
      </div>
      <% if @pagy.pages > 1 %>
        <div class="mt-12 flex justify-center">
          <nav class="flex items-center gap-1" aria-label="Pagination">
            <%== pagy_nav(@pagy) %>
          </nav>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-24">
        <svg viewBox="0 0 24 24" fill="none" class="w-8 h-8 text-flame mx-auto mb-4">
          <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z" fill="currentColor"/>
        </svg>
        <h2 class="text-lg font-semibold text-parchment mb-2">No results</h2>
        <p class="text-parchment-dim text-sm">Try a different search or category.</p>
      </div>
    <% end %>
  </div>
</div>
