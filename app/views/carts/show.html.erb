<% if cart_items.empty? %>
  <div class="min-h-[70vh] flex items-center justify-center bg-night">
    <div class="text-center max-w-md mx-auto px-6 py-20">
      <div class="flex justify-center gap-2 mb-6 items-end">
        <%= render "shared/animated_diya", size: 40 %>
        <%= render "shared/animated_diya", size: 32 %>
        <%= render "shared/animated_diya", size: 36 %>
      </div>
      <h1 class="text-2xl font-bold text-parchment mb-2">Your cart is empty</h1>
      <p class="text-parchment-dim text-sm mb-8">Add some festive hampers to get started.</p>
      <%= link_to products_path, class: "inline-flex items-center gap-2 bg-flame text-night font-semibold px-8 py-3.5 text-sm hover:bg-marigold transition-all rounded-md warm-shadow" do %>
        Shop Now <%= icon("arrow-right", css_class: "w-4 h-4") %>
      <% end %>
    </div>
  </div>
<% else %>
  <% subtotal = cart_subtotal
     shipping = shipping_for(subtotal)
     total = subtotal + shipping %>
  <div class="pt-24 pb-20 bg-night min-h-screen rangoli-pattern">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="font-display text-4xl tracking-tight text-parchment mb-2">Cart</h1>
      <div class="festive-divider mt-2 mb-10 w-24"></div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-4">
          <% cart_items.each do |item| %>
            <div class="flex gap-4 p-4 bg-ember border border-line rounded-xl warm-shadow" id="<%= dom_id(item.product, :cart_item) %>">
              <img src="<%= item.primary_image %>" alt="<%= item.name %>" class="w-20 h-20 object-cover flex-shrink-0 rounded-lg border border-line">
              <div class="flex-1 min-w-0">
                <%= link_to item.name, product_path(item.slug), class: "font-semibold text-parchment hover:text-flame transition-colors text-sm block truncate" %>
                <p class="text-xs text-flame font-medium mt-0.5"><%= format_price(item.price) %></p>
                <div class="flex items-center justify-between mt-3">
                  <div class="flex items-center gap-2">
                    <%= button_to update_cart_item_path(item.id, quantity: item.quantity - 1), method: :patch,
                          form_class: "inline", class: "w-7 h-7 border border-line flex items-center justify-center hover:bg-ember-light transition-colors rounded-md text-parchment",
                          aria: { label: "Decrease quantity" } do %><%= icon("minus", css_class: "w-3 h-3") %><% end %>
                    <span class="w-8 text-center text-sm font-medium text-parchment"><%= item.quantity %></span>
                    <%= button_to update_cart_item_path(item.id, quantity: item.quantity + 1), method: :patch,
                          form_class: "inline", class: "w-7 h-7 border border-line flex items-center justify-center hover:bg-ember-light transition-colors rounded-md text-parchment",
                          aria: { label: "Increase quantity" } do %><%= icon("plus", css_class: "w-3 h-3") %><% end %>
                  </div>
                  <div class="flex items-center gap-4">
                    <span class="font-semibold text-sm text-flame"><%= format_price(item.line_total) %></span>
                    <%= button_to cart_item_path(item.id), method: :delete,
                          form_class: "inline", class: "text-parchment-dim hover:text-kumkum transition-colors",
                          aria: { label: "Remove #{item.name}" } do %><%= icon("trash", css_class: "w-4 h-4") %><% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
          <%= button_to "Clear all", cart_path, method: :delete,
                form_class: "inline", class: "text-xs text-parchment-dim hover:text-kumkum transition-colors" %>
        </div>

        <div class="lg:col-span-1">
          <div class="sticky top-28 bg-ember border border-line p-6 rounded-xl warm-shadow">
            <h2 class="text-sm font-semibold text-parchment uppercase tracking-wider mb-5 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" class="w-3 h-3 text-flame"><path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z" fill="currentColor"/></svg>
              Summary
            </h2>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-parchment-dim">Subtotal</span>
                <span class="font-medium text-parchment"><%= format_price(subtotal) %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-parchment-dim">Shipping</span>
                <span class="font-medium <%= shipping.zero? ? 'text-leaf' : 'text-parchment' %>"><%= shipping.zero? ? "Free" : format_price(shipping) %></span>
              </div>
              <% if shipping > 0 %><p class="text-xs text-parchment-dim">Add <%= format_price(999 - subtotal) %> more for free shipping</p><% end %>
              <div class="border-t border-line pt-3 flex justify-between">
                <span class="font-semibold text-parchment">Total</span>
                <span class="font-bold text-flame"><%= format_price(total) %></span>
              </div>
            </div>
            <%= link_to checkout_path, class: "mt-6 block w-full bg-flame text-night font-semibold py-3.5 text-sm text-center hover:bg-marigold transition-all rounded-md warm-shadow" do %>
              Checkout
            <% end %>
            <%= link_to products_path, class: "mt-3 block text-center text-xs text-parchment-dim hover:text-flame transition-colors" do %>
              Continue Shopping
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
