<div class="absolute inset-0 overflow-hidden pointer-events-none">
  <% particles = Array.new(16) { |i|
       {
         id: i,
         x: rand * 100,
         y: rand * 100,
         size: (3 + rand * 10).round,
         color: ["#E9B44C", "#E8731F", "#F4A236", "#FF6B00", "#D66012"].sample,
         delay: (rand * 8).round(2),
         duration: (9 + rand * 12).round(2)
       }
     } %>
  <% particles.each do |p| %>
    <div class="absolute animate-float" style="left: <%= p[:x] %>%; top: <%= p[:y] %>%; animation-delay: <%= p[:delay] %>s; animation-duration: <%= p[:duration] %>s;">
      <svg width="<%= p[:size] %>" height="<%= p[:size] %>" viewBox="0 0 20 20" fill="none">
        <% if p[:id] % 3 == 0 %>
          <path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8 Z" fill="<%= p[:color] %>" opacity="0.14"/>
        <% elsif p[:id] % 3 == 1 %>
          <circle cx="10" cy="10" r="8" fill="<%= p[:color] %>" opacity="0.1"/>
        <% else %>
          <path d="M10 2 L13 8 L10 14 L7 8 Z M2 10 L8 7 L14 10 L8 13 Z" fill="<%= p[:color] %>" opacity="0.11"/>
        <% end %>
      </svg>
    </div>
  <% end %>
</div>
