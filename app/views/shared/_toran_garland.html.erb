<%
  toran_w = 1440
  knots = Array.new(13) do |i|
    x = (i + 0.5) * (toran_w / 13.0)
    t = x / toran_w
    y = 14 + Math.sin(Math::PI * t) * 26
    sway = (i.even? ? 1 : -1) * (2 + (i % 3))
    dur = 4 + (i % 4) * 0.8
    { x: x, y: y, sway: sway, dur: dur }
  end
%>
<div class="absolute top-0 left-0 right-0 h-24 md:h-32 overflow-hidden pointer-events-none z-20">
  <svg viewBox="0 0 <%= toran_w %> 150" preserveAspectRatio="xMidYMid slice" class="w-full h-full">
    <!-- String -->
    <path d="M0 14 Q <%= toran_w / 2 %> 40 <%= toran_w %> 14" fill="none" stroke="#C8B395" stroke-width="1.5" opacity="0.35"/>
    <% knots.each_with_index do |k, i| %>
      <% if i % 3 == 0 %>
        <g transform="translate(<%= k[:x] + 16 %> <%= k[:y] + 2 %>)">
          <animateTransform attributeName="transform" type="rotate" additive="sum"
            values="-4 0 0;4 0 0;-4 0 0" dur="<%= 5 + i %>s" repeatCount="indefinite"/>
          <path d="M0 0 C-5 7 -5 16 0 20 C5 16 5 7 0 0 Z" fill="#5D8A46" opacity="0.8"/>
          <path d="M0 2 L0 18" stroke="#3E6B30" stroke-width="0.7" opacity="0.7"/>
        </g>
        <g transform="translate(<%= k[:x] - 16 %> <%= k[:y] + 2 %>)">
          <animateTransform attributeName="transform" type="rotate" additive="sum"
            values="4 0 0;-4 0 0;4 0 0" dur="<%= 6 + i * 0.7 %>s" repeatCount="indefinite"/>
          <path d="M0 0 C-5 7 -5 16 0 20 C5 16 5 7 0 0 Z" fill="#5D8A46" opacity="0.8"/>
          <path d="M0 2 L0 18" stroke="#3E6B30" stroke-width="0.7" opacity="0.7"/>
        </g>
      <% end %>
    <% end %>
    <% r = ->(rad) {
         out = +"<circle r='#{rad * 1.05}' fill='#D66012' opacity='0.95'/>"
         6.times do |j|
           a = j * 60 * Math::PI / 180
           px = Math.cos(a) * rad * 0.55
           py = Math.sin(a) * rad * 0.55
           out << "<circle cx='#{"%.2f" % px}' cy='#{"%.2f" % py}' r='#{rad * 0.38}' fill='#E8731F'/>"
         end
         out << "<circle r='#{rad * 0.5}' fill='#F4A236'/><circle r='#{rad * 0.18}' fill='#FFD97A'/>"
         out
       } %>
    <% knots.each_with_index do |k, i| %>
      <% rad = (i.zero? || i == knots.length - 1) ? 13 : 10.5 %>
      <g transform="translate(<%= k[:x] %> <%= k[:y] %>)">
        <animateTransform attributeName="transform" type="rotate" additive="sum"
          values="<%= -k[:sway] %> 0 0;<%= k[:sway] %> 0 0;<%= -k[:sway] %> 0 0"
          dur="<%= k[:dur] %>s" repeatCount="indefinite"/>
        <g><%= raw(r.call(rad)) %></g>
      </g>
    <% end %>
  </svg>
</div>
