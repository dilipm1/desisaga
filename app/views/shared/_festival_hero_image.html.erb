<%# Subtle animated background image for upcoming festival — right side of hero (config/festival_images.yml is source) %>
<% festival_category = local_assigns[:festival]&.category
   festival_name = local_assigns[:festival]&.name
   hero_image = FestivalImagesHelper.image_for(festival_category) || FestivalImagesHelper.festival_images_config["default"]
%>

<div class="hidden lg:block absolute right-6 xl:right-10 top-1/2 -translate-y-1/2 w-[420px] xl:w-[520px] h-[480px] xl:h-[560px] pointer-events-none select-none" aria-hidden="true">
  <!-- soft glow behind -->
  <div class="absolute -inset-6 bg-gradient-to-br from-flame/10 via-marigold/5 to-kumkum/10 blur-[60px] rounded-[2.5rem]"></div>

  <!-- image card -->
  <div class="relative w-full h-full rounded-[2rem] overflow-hidden border border-line/30 bg-ember/30 backdrop-blur-[2px] warm-shadow-lg animate-float" style="animation-duration: 14s;">
    <img src="<%= hero_image %>" alt="<%= festival_name || "Festival" %>" class="w-full h-full object-cover opacity-[0.22] scale-[1.03]" loading="eager" />

    <!-- subtle gradients to keep image muted and blend into night -->
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-transparent opacity-80"></div>
    <div class="absolute inset-0 bg-gradient-to-l from-night/55 via-transparent to-ember/20"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-flame/[0.06] via-transparent to-kumkum/[0.08]"></div>

    <!-- top highlight line -->
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-flame/20 to-transparent"></div>

    <!-- floating diya accent over image -->
    <div class="absolute bottom-6 right-6 opacity-60">
      <%= render "shared/animated_diya", size: 36 %>
    </div>

    <!-- festival label on image (subtle) -->
    <% if festival_name %>
      <div class="absolute bottom-6 left-6 right-20">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-parchment/60">Up next</p>
        <p class="font-display text-lg text-parchment/80 mt-1 leading-tight"><%= festival_name %></p>
      </div>
    <% end %>
  </div>

  <!-- secondary blurred orb accent -->
  <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-marigold/10 blur-[30px]"></div>
</div>
