<%
  next_festival = Festivals.next_festival
  category_links = [["Shop", products_path], ["Diwali", products_path(category: "Diwali")], ["Wedding", products_path(category: "Wedding")], ["Puja", products_path(category: "Puja")]]
%>
<nav data-controller="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-night/90 backdrop-blur-md border-b border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-18">
      <%= link_to root_path, class: "flex items-center gap-2.5", aria: { label: "Desi Saga Home" } do %>
        <span class="font-display text-xl tracking-tight text-parchment">DESI SAGA</span>
      <% end %>

      <div class="hidden md:flex items-center gap-8" data-navbar-target="links">
        <% category_links.each do |label, href| %>
          <%= link_to label, href, class: "text-sm font-medium text-parchment-dim hover:text-flame transition-colors" %>
        <% end %>
      </div>

      <div class="flex items-center gap-3">
        <% if next_festival %>
          <%= link_to products_path(category: next_festival[:festival].category),
                class: "hidden lg:inline-flex items-center gap-2 border border-flame/40 rounded-full pl-3.5 pr-2.5 py-1.5 font-mono text-xs text-parchment-dim hover:text-flame hover:border-flame/70 transition-colors" do %>
            <span class="w-1.5 h-1.5 rounded-full bg-flame animate-pulse"></span>
            <%= next_festival[:festival].name %> · <%= next_festival[:days_left] %>d
            <%= icon("arrow-right", css_class: "w-3 h-3") %>
          <% end %>
        <% end %>

        <%= link_to cart_path,
              class: "relative p-2 rounded-md transition-colors text-parchment hover:text-flame hover:bg-ember",
              aria: { label: cart_count > 0 ? "Cart with #{cart_count} items" : "Cart" } do %>
          <%= icon("shopping-bag") %>
          <% if cart_count > 0 %>
            <span class="absolute -top-0.5 -right-0.5 bg-flame text-night text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center"><%= cart_count %></span>
          <% end %>
        <% end %>

        <% if authenticated? %>
          <div class="hidden md:flex items-center gap-2">
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-flame hover:underline", aria: { label: "Admin Panel" } %>
            <% end %>
            <span class="text-sm text-parchment-dim hidden lg:inline"><%= current_user.display_name %></span>
            <%= button_to session_path, method: :delete, form_class: "inline", class: "inline-flex items-center gap-1.5 p-2 rounded-md transition-colors text-parchment-dim hover:text-flame hover:bg-ember text-sm font-medium", aria: { label: "Sign out" } do %>
              <%= icon("log-out", css_class: "w-4 h-4") %> Sign out
            <% end %>
          </div>
        <% else %>
          <%= link_to new_session_path, class: "hidden md:inline-flex items-center gap-1.5 p-2 rounded-md transition-colors text-parchment hover:text-flame hover:bg-ember text-sm font-medium", aria: { label: "Sign in" } do %>
            <%= icon("user", css_class: "w-4 h-4") %> Sign in
          <% end %>
        <% end %>

        <button type="button" data-action="navbar#toggleMenu"
          class="md:hidden p-2 rounded-md text-parchment hover:bg-ember transition-colors"
          aria-label="Toggle menu">
          <%= icon("menu", css_class: "w-5 h-5", data: { navbar_target: "openIcon" }) %>
          <%= icon("x", css_class: "w-5 h-5 hidden", data: { navbar_target: "closeIcon" }) %>
        </button>
      </div>
    </div>

    <div data-navbar-target="mobileMenu" class="hidden md:hidden pb-6 pt-2 space-y-1 bg-night border border-line rounded-b-2xl shadow-2xl animate-fade-in">
      <%= link_to "Shop All", products_path, class: "block py-2.5 px-4 text-sm font-medium text-parchment-dim hover:text-flame hover:bg-ember rounded-md transition-colors" %>
      <%= link_to "Diwali", products_path(category: "Diwali"), class: "block py-2.5 px-4 text-sm font-medium text-parchment-dim hover:text-flame hover:bg-ember rounded-md transition-colors" %>
      <%= link_to "Wedding", products_path(category: "Wedding"), class: "block py-2.5 px-4 text-sm font-medium text-parchment-dim hover:text-flame hover:bg-ember rounded-md transition-colors" %>
      <%= link_to "Puja", products_path(category: "Puja"), class: "block py-2.5 px-4 text-sm font-medium text-parchment-dim hover:text-flame hover:bg-ember rounded-md transition-colors" %>
      <% if authenticated? %>
        <div class="pt-2 px-4 space-y-2">
          <p class="text-sm text-parchment-dim">Signed in as <span class="text-flame"><%= current_user.display_name %></span></p>
          <% if current_user.admin? %>
            <%= link_to "Admin Panel →", admin_root_path, class: "block py-2 text-sm font-medium text-flame" %>
          <% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "w-full bg-flame text-night py-2 px-4 rounded-md text-sm font-medium hover:opacity-90 transition-opacity" %>
        </div>
      <% else %>
        <div class="pt-2 px-4">
          <%= link_to "Sign in", new_session_path, class: "block w-full text-center bg-flame text-night py-2 px-4 rounded-md text-sm font-medium hover:opacity-90 transition-opacity" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
