<!DOCTYPE html>
<html lang="en" class="h-full antialiased">
  <head>
    <title>Desi Saga — Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Instrument+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>

  <body class="min-h-full flex flex-col bg-night bg-paisley">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-night/90 backdrop-blur-md border-b border-line">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between h-16">
        <div class="flex items-center gap-6">
          <span class="font-display text-xl tracking-tight text-parchment">DESI SAGA <span class="font-mono text-xs text-flame align-middle">ADMIN</span></span>
          <%= link_to "Inventory", admin_products_path, class: "text-sm font-medium text-parchment-dim hover:text-flame transition-colors" %>
          <%= link_to "Analytics", "/admin/blazer", class: "text-sm font-medium text-parchment-dim hover:text-flame transition-colors" %>
        </div>
        <div class="flex items-center gap-4">
          <%= link_to "View store", root_path, class: "text-sm font-medium text-parchment-dim hover:text-flame transition-colors" %>
          <% if authenticated? %>
            <%= button_to "Sign out", session_path, method: :delete, class: "inline-flex items-center gap-1.5 p-2 rounded-md text-parchment-dim hover:text-flame hover:bg-ember text-sm font-medium", form_class: "inline" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="flex-1 pt-24 pb-16 px-6 lg:px-8">
      <% if notice %><div class="max-w-7xl mx-auto mb-6"><p class="bg-ember border border-flame/40 text-parchment text-sm px-4 py-3 rounded-lg"><%= notice %></p></div><% end %>
      <% if alert %><div class="max-w-7xl mx-auto mb-6"><p class="bg-kumkum/20 border border-kumkum/50 text-kumkum text-sm px-4 py-3 rounded-lg"><%= alert %></p></div><% end %>
      <div class="max-w-7xl mx-auto"><%= yield %></div>
    </main>
  </body>
</html>
