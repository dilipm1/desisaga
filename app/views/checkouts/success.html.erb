<div class="min-h-[70vh] flex items-center justify-center bg-night rangoli-pattern">
  <div class="text-center max-w-md mx-auto px-6 py-20">
    <div class="flex justify-center items-end gap-2 mb-6">
      <%= render "shared/animated_diya", size: 48 %>
      <%= render "shared/animated_diya", size: 36 %>
    </div>
    <h1 class="font-display text-3xl text-flame-gradient mb-3">Shubh Labh!</h1>
    <h2 class="text-xl font-bold text-parchment mb-2">Order placed</h2>
    <p class="text-parchment-dim text-sm mb-8 leading-relaxed">
      This is a test-mode demo — no payment was taken. Once Stripe is connected, your hamper will be on its way before the celebration.
    </p>
    <%= link_to products_path, class: "inline-flex items-center gap-2 bg-flame text-night font-semibold px-8 py-3.5 text-sm hover:bg-marigold transition-all rounded-md warm-shadow" do %>
      Keep Shopping <%= icon("arrow-right", css_class: "w-4 h-4") %>
    <% end %>
  </div>
</div>
